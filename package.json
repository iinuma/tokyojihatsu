{
  "name": "tokyojihatsu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "東京次発 — Even G2 向け 駅時刻表カウントダウン（ODPT コア）",
  "scripts": {
    "build:master": "tsx scripts/build-master.ts",
    "next": "tsx src/cli/next.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "probe:dev": "LAN_IP=$(./scripts/lan-ip.sh) vite --config probe/vite.config.ts",
    "probe:build": "vite build --config probe/vite.config.ts",
    "probe:pack": "npm run probe:build && evenhub pack probe/app.json dist/probe -o dist/tokyojihatsu-probe.ehpk --sdk-ver 0.0.15",
    "probe:qr": "evenhub qr --url \"http://$(./scripts/lan-ip.sh):5173\"",
    "app:dev": "LAN_IP=$(./scripts/lan-ip.sh) vite --config app/vite.config.ts",
    "app:build": "vite build --config app/vite.config.ts",
    "app:pack": "npm run app:build && evenhub pack app/app.json dist/app -o dist/tokyojihatsu.ehpk --sdk-ver 0.0.15",
    "app:qr": "evenhub qr --url \"http://$(./scripts/lan-ip.sh):5174\""
  },
  "devDependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.15",
    "@evenrealities/evenhub-cli": "^0.1.14",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.3"
  }
}
