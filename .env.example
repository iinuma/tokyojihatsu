# ODPT（公共交通オープンデータセンター）のアクセストークン
# https://developer.odpt.org/ で取得する
ODPT_TOKEN=your_consumer_key_here

# Vite のバンドルに埋め込まれる同じキー（ローカル検証用）。
# .ehpk に含まれるため、Even Hub で公開するビルドでは使わずプロキシ経由にする。
VITE_ODPT_TOKEN=your_consumer_key_here

# プロキシの URL（CDK デプロイ後に出力される Function URL）。
# これを設定すると鍵はバンドルに入らない。公開ビルドでは必ず設定する。
VITE_ODPT_PROXY=https://xxxxx.lambda-url.ap-northeast-1.on.aws/
